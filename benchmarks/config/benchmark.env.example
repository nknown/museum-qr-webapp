# Copy to benchmark.env and keep local deployment values out of Git.
MIYP_BENCHMARK_BASE_URL=https://museum-host.example:8000
MIYP_BENCHMARK_CERTIFICATE=/absolute/path/to/miyp-public-certificate.crt

# Set to 1 instead of MIYP_BENCHMARK_CERTIFICATE for a publicly trusted server.
USE_SYSTEM_CA=0

# Optional requester configuration.
PRESENTATIONS_FILE=benchmarks/config/presentations.txt
BENCHMARK_HEALTH_PATH=/
PYTHON=python3

# Optional server-monitor configuration. The defaults match docker-compose.yml.
# COMPOSE_PROJECT_NAME=museum-qr-webapp
WEB_SERVICE=web
DATABASE_SERVICE=db
PROXY_SERVICE=nginx
POSTGRES_USER=miyp_user
POSTGRES_DB=miyp_database
SAMPLE_INTERVAL_SECONDS=1
FINAL_IDLE_SECONDS=60
