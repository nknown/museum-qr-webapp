#!/bin/sh
# Docker credential-helper protocol for the public images used by MIYP.
# It deliberately reports no saved credentials so headless deployments use
# anonymous registry access instead of trying the desktop Secret Service.
set -eu

case ${1:-} in
    get)
        cat >/dev/null
        printf '{"Username":"","Secret":""}\n'
        ;;
    list)
        printf '{}\n'
        ;;
    erase)
        cat >/dev/null
        ;;
    store)
        cat >/dev/null
        printf 'MIYP deployment registry credentials are intentionally disabled\n' >&2
        exit 1
        ;;
    *)
        printf 'unsupported credential-helper operation\n' >&2
        exit 1
        ;;
esac
