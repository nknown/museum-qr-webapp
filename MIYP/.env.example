# Copy this file to MIYP/.env, replace all placeholders, and never commit it.
PROJECT_NAME="Museum in Your Pocket"
PROJECT_ACRONYMUM="MIYP"
SITE_NAME="IST, Lisboa, Portugal"
TIME_ZONE="Europe/Lisbon"

MAIN_APP_PRODUCTION=off
MAIN_APP_REVERSE_PROXY=off
MAIN_APP_SECRET=replace-with-a-random-django-secret
MAIN_APP_ALLOWED_HOSTS=127.0.0.1,localhost,i7h8
MAIN_APP_CSRF_TRUSTED_ORIGINS=

JANUS_SERVER_ADDRESS=http://127.0.0.1:8088/janus
JANUS_STREAM_ADMIN_KEY=

MAIN_APP_GOOGLE_OAUTH=off
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=
GOOGLE_OAUTH_USE_LOOPBACK_REDIRECT=off
GOOGLE_OAUTH_LOOPBACK_HOST=localhost:8000

MAIN_APP_MS_OAUTH=off
SOCIAL_AUTH_MICROSOFT_GRAPH_KEY=
SOCIAL_AUTH_MICROSOFT_GRAPH_SECRET=

PUBLIC_HOSTNAME=i7h8
SERVER_NAME=http://127.0.0.1:8000/
WAGTAILADMIN_BASE_URL=http://127.0.0.1:8000/cms

DB_TYPE=postgres
POSTGRES_DB_NAME=miyp_database
POSTGRES_DB_USER=miyp_user
POSTGRES_DB_PASSWORD=replace-with-a-database-password
POSTGRES_DB_HOST=localhost
POSTGRES_DB_PORT=5432
POSTGRES_CONN_MAX_AGE=60

CACHE=off
CACHE_TYPE=locmemc

MAIN_APP_LTI_PROVIDER=off
IPGEOLOCATION_API_KEY=
